# Copy to .env and fill in — NEVER commit .env or any key file.
# The buyer wallet's private key (64 hex chars, no 0x prefix).
TZERO_PRIVATE_KEY=
# ...or a path to a JSON key file {"private_key": "<64 hex>"} stored OUTSIDE this repo:
# TZERO_KEY_FILE=/path/to/key.json
# Optional overrides:
# TZERO_RPC=https://sepolia.base.org
# TZERO_BUY_ETH=0.01
# TZERO_STATE=./state.json
# TZERO_WHITELIST=./whitelist.json
